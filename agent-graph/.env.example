# Copy to .env, fill in, then: chmod 600 .env
# Never commit .env. Never paste keys into issues, logs or chat.

# Jev through OpenRouter (Decisions API)
OPENROUTER_API_KEY=
# Opus 5.5
ANTHROPIC_API_KEY=
# Fine-grained PAT scoped to kingston2020/addons:
# Contents RW, Pull requests RW, Issues R, Checks R, Metadata R
GITHUB_TOKEN=
# Telegram bot from @BotFather, and your own chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Long random string. Dashboard refuses requests without it.
DASHBOARD_TOKEN=
# Where the database, worktrees and reports live
AGENT_HOME=./var
# 1 only after `python -m agentgraph check` passes
UNATTENDED=0
